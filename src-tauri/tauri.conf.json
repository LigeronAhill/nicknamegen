{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nicknamegen",
  "version": "0.1.0",
  "identifier": "com.master.nicknamegen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nicknamegen",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/favicon-32x32.png",
      "icons/favicon-144x144.png",
      "icons/favicon-256x256.png",
      "icons/iconcustom.ico"
    ]
  }
}
